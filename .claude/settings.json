{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dbt *)",
      "Bash(sqlfluff *)",
      "Bash(python scripts/generate_data.py *)",
      "Bash(./tasks.ps1 *)",
      "Bash(.\\tasks.ps1 *)",
      "Bash(pwsh ./tasks.ps1 *)",
      "Bash(powershell -File tasks.ps1 *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(az *)",
      "Bash(fab *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
