# Copy to .env and fill in. .env is gitignored. Comments must be on their own line.

# Entra tenant that hosts the Fabric demo
FABRIC_TENANT_ID=

# Capacity that hosts the LPB workspaces (name as shown in the Fabric admin portal)
FABRIC_CAPACITY_NAME=

# SQL connection string of wh_analytics in LPB-Data-Dev
# (Warehouse > Settings > SQL endpoint), e.g. xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_ENDPOINT=

FABRIC_WAREHOUSE=wh_analytics
FABRIC_LAKEHOUSE=lh_bronze

# dbt target from dbt/profiles.yml: dev or ci
DBT_TARGET=dev

# Teams Workflows webhook for the dbt alert (Teams channel > ... > Workflows > "Send webhook alerts to a channel").
# It works like a password. .\tasks.ps1 pipeline copies it to lh_bronze Files/_config; leave it empty for dry runs.
TEAMS_WEBHOOK_URL=
