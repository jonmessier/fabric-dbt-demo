/// One row per ERP invoice line (returns excluded) priced against list at the order date.
table 'Price Realization'
	lineageTag: 06f43b06-b31a-552f-bbb1-11a8153b1e97

	/// Invoiced amount against list price at the order date. 100% = sold at list.
	measure 'Realized Price %' = DIVIDE(SUM('Price Realization'[Net Amount]), SUM('Price Realization'[List Amount]))
		formatString: 0.0%
		lineageTag: 9e3e4213-ac42-5cac-b4d2-2f0a71142cf9

	/// Invoiced minus list amount (negative = discounts).
	measure 'Price Variance' = SUM('Price Realization'[Price Variance Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c3838ece-4751-5a1c-8338-ddf1512f8d6c

	column 'Invoice Line Key'
		dataType: string
		isHidden
		lineageTag: aea4bd1b-181d-516e-b125-d256156b399a
		summarizeBy: none
		sourceColumn: invoice_line_key

	/// Order date as yyyymmdd; joins to dim_date.
	column 'Order Date Key'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f0261d3c-5b7a-5536-ad8c-df4a8903be23
		summarizeBy: none
		sourceColumn: order_date_key

	column 'Order Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 6cc09351-04d7-5d26-b3ea-37b2ee733e9b
		summarizeBy: none
		sourceColumn: order_date

	column 'Invoice Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: c9e129bd-1750-5ea4-8a0d-5be6c0b9d4b6
		summarizeBy: none
		sourceColumn: invoice_date

	column 'Order No'
		dataType: string
		lineageTag: d69b3422-91c8-5e8c-bec1-661b312dd79c
		summarizeBy: none
		sourceColumn: order_no

	/// The customer version valid on the transaction date; joins to dim_customer.
	column 'Customer Version Key'
		dataType: string
		isHidden
		lineageTag: 681f9ec3-fb3f-5e22-8238-4bbfbbfa7676
		summarizeBy: none
		sourceColumn: customer_version_key

	/// ERP customer number (TAPROOM for walk-in taproom sales).
	column 'Customer No'
		dataType: string
		lineageTag: f11f0717-c17d-57ce-a58d-9bf6776017aa
		summarizeBy: none
		sourceColumn: customer_no

	/// Product; joins to dim_product.
	column 'Product Key'
		dataType: string
		isHidden
		lineageTag: 63d5c019-a11c-501f-83ff-9cc8053a230f
		summarizeBy: none
		sourceColumn: product_key

	column 'Price Tier'
		dataType: string
		lineageTag: 125ad6ec-6f95-5e1a-a9ba-fac705d6c9f2
		summarizeBy: none
		sourceColumn: price_tier

	/// Units in the line's own unit (keg, case, pour, pack, item).
	column Quantity
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 7941652f-aa65-590e-9aeb-8ceec64d938a
		summarizeBy: none
		sourceColumn: quantity

	/// List price for the item and the customer's tier on the order date.
	column 'List Price'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: 20b01e62-9946-5510-a7d7-37b521b347aa
		summarizeBy: none
		sourceColumn: list_price

	column 'Invoiced Unit Price'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: 6f1d76af-21f9-5456-a9eb-65dee4eb5d09
		summarizeBy: none
		sourceColumn: invoiced_unit_price

	column 'Line Discount %'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: 0c65aced-4b4c-5eeb-ac8b-ce0bfeb5de55
		summarizeBy: none
		sourceColumn: line_discount_pct

	/// Billed amount after discounts. Negative on returns.
	column 'Net Amount'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: 7fd41615-dc9d-5928-8090-172d511b09bf
		summarizeBy: none
		sourceColumn: net_amount

	column 'List Amount'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: aa2f4bde-0cf7-5e79-8374-15cfe82ef978
		summarizeBy: none
		sourceColumn: list_amount

	/// net_amount - list_amount.
	column 'Price Variance Amount'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: a22c285c-41cc-5f9f-a50a-2167a4a497d0
		summarizeBy: none
		sourceColumn: price_variance_amount

	/// net_amount / list_amount; 1.0 means sold at list.
	column 'Price Realization %'
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: f45bd36f-3494-5648-9ab1-6c340076e8ce
		summarizeBy: none
		sourceColumn: price_realization_pct

	partition 'Price Realization' = entity
		mode: directLake
		source
			entityName: fct_price_realization
			schemaName: gold
			expressionSource: 'DirectLake - wh_analytics'

